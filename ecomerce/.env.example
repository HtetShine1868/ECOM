# ─── Database ────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-very-long-random-secret-key-at-least-512-bits

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── OAuth2 ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth2-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth2-client-secret
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ─── URLs ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# ─── Admin Account ───────────────────────────────────────────
# Required to create the first admin. Never commit a real password.
# Use a unique password of at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Local schema updates. In production set this to validate or none.
JPA_DDL_AUTO=update

# ─── Redis (optional) ────────────────────────────────────────
# Used for: product/category cache, the shopping cart, shared rate-limit counters.
# Leave REDIS_URL empty to run without Redis: no cache, carts live in PostgreSQL,
# rate limits are counted per server. Use redis:// or rediss:// (TLS).
# On Render use the INTERNAL url of your Redis service (only reachable from Render).
REDIS_URL=
# REDIS_ENABLED: auto (default, on when REDIS_URL is set) | true | false
REDIS_ENABLED=auto
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=1000
REDIS_CIRCUIT_OPEN_SECONDS=30

# ─── Cache TTLs ──────────────────────────────────────────────
CACHE_TTL_PRODUCT_SECONDS=300
CACHE_TTL_CATEGORY_SECONDS=600
CACHE_TTL_LISTING_SECONDS=120

# ─── Cart ────────────────────────────────────────────────────
CART_TTL_DAYS=7
CART_MAX_QTY_PER_ITEM=99
CART_MAX_DISTINCT_ITEMS=50

# ─── Checkout idempotency ────────────────────────────────────
IDEMPOTENCY_PROCESSING_TIMEOUT_SECONDS=120

# ─── Transactional outbox (in-process, no message broker) ────
OUTBOX_POLL_INTERVAL_MS=3000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BACKOFF_BASE_SECONDS=5
OUTBOX_BACKOFF_MAX_SECONDS=600

# ─── Rate limiting (fixed window; max requests per window) ───
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_SECONDS=900
RATE_LIMIT_AUTH_ACCOUNT_MAX=8
RATE_LIMIT_AUTH_ACCOUNT_WINDOW_SECONDS=900
RATE_LIMIT_CHECKOUT_MAX=10
RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=60
RATE_LIMIT_CART_MAX=90
RATE_LIMIT_CART_WINDOW_SECONDS=60
RATE_LIMIT_SEARCH_MAX=150
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
RATE_LIMIT_PRODUCT_MAX=400
RATE_LIMIT_PRODUCT_WINDOW_SECONDS=60
RATE_LIMIT_ADMIN_MAX=600
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_CHAT_WINDOW_SECONDS=60
