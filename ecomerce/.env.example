# ─── Database ────────────────────────────────────────────────
DATABASE_URL=jdbc:postgresql://db.xxxxxxxxxxxx.supabase.co:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# ─── JWT ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-very-long-random-secret-key-at-least-512-bits

# ─── Supabase ────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── OAuth2 ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-oauth2-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth2-client-secret
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ─── URLs ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8080

# ─── Admin Account ───────────────────────────────────────────
# Required to create the first admin. Never commit a real password.
# Use a unique password of at least 12 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Local schema updates. In production set this to validate or none.
JPA_DDL_AUTO=update
